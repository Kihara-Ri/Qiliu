{
  "name": "qiliu",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "npm run version:check && npm run test && npm run build && npm run test:rust",
    "version:check": "node scripts/sync-version.mjs --check",
    "version:sync": "node scripts/sync-version.mjs",
    "release:prepare": "bash scripts/prepare-release.sh",
    "package:current": "node scripts/build-current-platform.mjs",
    "package:macos": "bash scripts/package-macos.sh",
    "package:windows": "tauri build --bundles nsis",
    "package:android": "bash scripts/package-android.sh",
    "package:android:release": "bash scripts/package-android.sh --release",
    "android:init": "tauri android init --ci",
    "android:icons": "node scripts/sync-android-icons.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "bootstrap-icons": "^1.13.1",
    "hls.js": "^1.7.1",
    "mpegts.js": "^1.8.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
